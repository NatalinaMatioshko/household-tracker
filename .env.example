# Copy this file to `.env` and fill in real values.
# Never commit `.env` (it is gitignored).

# PostgreSQL connection string (Prisma)
#
# --- Supabase (recommended for this project) ---
# Do NOT use the "Direct connection" host `db.<project>.supabase.co:5432`
# if migrate fails with P1001 — many networks have no working IPv6.
#
# In Supabase Dashboard → Project Settings → Database → Connection string:
#   1. Pick "URI"
#   2. Use Mode: "Session" (pooler) — host looks like:
#        aws-0-<region>.pooler.supabase.com
#      port 5432 (session) or 6543 (transaction)
#   3. User is often: postgres.<project-ref>
#   4. Add sslmode=require
#
# Example (Session pooler — good for prisma migrate):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# If the project was paused (free tier), open the Supabase dashboard and Restore it first.
#
# --- Local Docker (optional) ---
# docker run --name ht-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=household_tracker -p 5432:5432 -d postgres:16
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/household_tracker?schema=public"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js (next-auth v5) — required for login sessions
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional in local dev (defaults to http://localhost:3000)
# AUTH_URL="http://localhost:3000"
