// Household Tracker schema — Auth.js + Prisma + PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  HYGIENE
  CARE
  HOUSEHOLD_CHEMICALS
  LAUNDRY
  KITCHEN
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Auth.js email/password hash.
  passwordHash String?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  brand     String?
  category  Category
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model Purchase {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price         Float
  quantity      Int       @default(1)
  datePurchased DateTime  @db.Date
  dateEnded     DateTime? @db.Date
  store         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
}
